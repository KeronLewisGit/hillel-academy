APP_NAME="Hillel Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.gohillel.com
APP_TIMEZONE=America/Jamaica
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_hillel
DB_USERNAME=u000000000_hillel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Hostinger mailbox (hPanel → Emails).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=admissions@gohillel.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admissions@gohillel.com
MAIL_FROM_NAME="${APP_NAME}"

# true on the temporary preview domain: banner + noindex. Remove at launch.
HILLEL_PREVIEW=false
# Demo only: shows family sign-in links on screen. Ignored when APP_ENV=production.
HILLEL_DEMO_LINKS=false
# Fallback for who gets new enquiry/application emails (the dashboard Settings page overrides it).
HILLEL_NOTIFY_EMAIL=

# First staff account, created by `php artisan db:seed` (or setup.php). Remove the password after first sign-in.
#ADMIN_NAME="Administrator"
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
